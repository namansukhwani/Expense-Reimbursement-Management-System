# Application
APP_PORT=3000
APP_ENV=development
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=expense_user
DB_PASSWORD=secret
DB_DATABASE=expense_reimbursement

# JWT
JWT_SECRET=your-secret-key-please-change
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# System
DEFAULT_BASE_CURRENCY=USD
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf
